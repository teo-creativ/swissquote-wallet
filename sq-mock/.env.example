# sq-mock (CDC annex C). Names only. Values live in .env.local (git-ignored) and in the Vercel project sq-keys-mock.
# Leave SQ_SUPABASE_URL empty to run on the in-memory store (local dev and tests).
SQ_SUPABASE_URL=
SQ_SUPABASE_SERVICE_ROLE_KEY=
APP_TO_SQ_SECRET=
SQ_SHARE_ENC_KEY=
SQ_SHARE_ENC_KEY_VERSION=1
SQ_GAS_PRIVATE_KEY=
SQ_DEMO_WALLET_PRIVATE_KEY=
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
RECOVERY_DELAY_SECONDS=120
GAS_DRIP_WEI=300000000000000
GAS_DRIP_MIN_BALANCE_WEI=100000000000000
GAS_DRIP_DAILY_CAP=50
CONSOLE_PASSWORD=
# Simulated login and identity check: demo password of the seeded clients and expected banking answer.
SQ_DEMO_PASSWORD=
SQ_DEMO_BANKING_ANSWER=
# Live Safe mode (docs/prompts/live/01-safe-live.md): sponsored gas. Candide is the first choice, the sponsor key is the fallback.
CANDIDE_API_KEY=
SQ_URL=
# Sponsor limits (the sponsor wallet pays all gas; owners hold no ETH). Optional, defaults in code.
SPONSOR_MAX_DEPLOYS_PER_DAY=30
SPONSOR_MAX_EXECS_PER_DAY=300
SPONSOR_MAX_EXECS_PER_SAFE_PER_DAY=40
SPONSOR_MIN_BALANCE_WEI=5000000000000000
